{
    "name": "schachbulle/contao-schachaufgaben-bundle",
    "type": "contao-bundle",
    "description": "Schachaufgaben-Training für Contao nach dem Vorbild von lichess.org/training: Aufgaben mit Wertungszahl, Spiel als Mitglied oder Gast, Ranglisten.",
    "keywords": [
        "contao",
        "schach",
        "chess",
        "schachaufgaben",
        "taktik",
        "puzzle",
        "training",
        "rangliste"
    ],
    "homepage": "https://github.com/Samson1964/contao-schachaufgaben-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.7"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoSchachaufgabenBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoSchachaufgabenBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-schachaufgaben-bundle/issues",
        "source": "https://github.com/Samson1964/contao-schachaufgaben-bundle"
    }
}
